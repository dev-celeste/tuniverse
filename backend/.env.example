# Copy to backend/.env and fill in. Never commit the real .env.

# --- Spotify app (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI in the Spotify dashboard (127.0.0.1, not localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# --- Frontend ---
# Where to send the browser after login. Leave unset for backend-only mode
# (the callback returns JSON instead of redirecting).
# FRONTEND_URL=http://127.0.0.1:5173

# Comma-separated. Only matters for cross-origin calls; the Vite proxy makes dev same-origin.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Sessions ---
# Unset = in-memory sessions (dev only: lost on restart). Set in production.
# REDIS_URL=redis://localhost:6379/0

# true in production (HTTPS). Must be false for local http://127.0.0.1.
# COOKIE_SECURE=false
